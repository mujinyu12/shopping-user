# ============================================================
#  慕今予商城 · 用户端（Vue3 + Vite + TS）.gitignore
#  注意：.env.development / .env.production 里只有本地端口地址，
#        没有密钥，需要提交；带 .local 后缀的才是个人覆盖配置，不入库
# ============================================================

# ---------- 1. 依赖 ----------
node_modules/
.pnpm-store/
.yarn/cache
.yarn/install-state.gz

# ---------- 2. 构建产物 ----------
dist/
dist-ssr/
output/
coverage/
# vue-tsc -b 产生的增量编译信息，会随每次构建变化
*.tsbuildinfo

# ---------- 3. 缓存 ----------
.vite/
.tmp/
.eslintcache
.stylelintcache
.cache/

# ---------- 4. 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 5. 环境变量（只忽略个人本地覆盖） ----------
*.local
.env.local
.env.*.local

# ---------- 6. 编辑器 / 系统 ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?